//PICRD10J JOB (ACCT),'PI CARD ISSUANCE',
//         CLASS=A,MSGCLASS=X,MSGLEVEL=(1,1),
//         NOTIFY=&SYSUID,REGION=0M,TIME=0030
//*
//*****************************************************************
//* JOB: PICRD10J                                                  *
//* DESC: PLASTIC ISSUANCE - DAILY CARD ISSUANCE BATCH             *
//* FREQ: DAILY - CA7 SCHEDULED 06:00 AM                           *
//* PROGRAMS: PICRD100 (COBOL/DB2)                                 *
//* INPUT: CARD REQUEST FILE FROM UPSTREAM SYSTEM                  *
//* OUTPUT: ISSUED CARDS FILE, ERROR FILE, REPORT                  *
//*****************************************************************
//*
//*------- STEP 01: SORT INPUT BY ACCOUNT NUMBER ------------------
//*
//STEP010  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=PI.DAILY.CARD.REQUESTS,
//            DISP=SHR
//SORTOUT  DD DSN=&&SORTREQ,
//            DISP=(NEW,PASS),
//            SPACE=(CYL,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=300,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(3,12,CH,A)
  INCLUDE COND=(1,2,CH,EQ,C'NC',OR,1,2,CH,EQ,C'RC')
/*
//*
//*------- STEP 02: EXECUTE CARD ISSUANCE PROGRAM -----------------
//*
//STEP020  EXEC PGM=IKJEFT01,DYNAMNBR=20,COND=(4,LT)
//STEPLIB  DD DSN=PI.PROD.LOADLIB,DISP=SHR
//         DD DSN=DB2.PROD.SDSNLOAD,DISP=SHR
//DBRMLIB  DD DSN=PI.PROD.DBRMLIB(PICRD100),DISP=SHR
//CARDINP  DD DSN=&&SORTREQ,
//            DISP=(OLD,DELETE)
//CARDOUT  DD DSN=PI.DAILY.ISSUED.CARDS(&DATE.),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=FB,LRECL=350,BLKSIZE=0)
//CARDERR  DD DSN=PI.DAILY.CARD.ERRORS(&DATE.),
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(5,2),RLSE),
//            DCB=(RECFM=FB,LRECL=380,BLKSIZE=0)
//CARDRPT  DD SYSOUT=*,
//            DCB=(RECFM=FA,LRECL=133,BLKSIZE=0)
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2P)
  RUN  PROGRAM(PICRD100) PLAN(PIPLAN01) -
       LIB('PI.PROD.LOADLIB')
  END
/*
//*
//*------- STEP 03: CHECK RETURN CODE AND SEND NOTIFICATION -------
//*
//STEP030  EXEC PGM=IEBGENER,COND=(0,NE,STEP020)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
  PICRD10J - CARD ISSUANCE COMPLETED SUCCESSFULLY
/*
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
//*
//STEP040  EXEC PGM=IEBGENER,COND=(0,EQ,STEP020)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD *
  *** PICRD10J - CARD ISSUANCE FAILED - INVESTIGATE ***
/*
//SYSUT2   DD SYSOUT=*
//SYSIN    DD DUMMY
//
